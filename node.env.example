# Copy to node.local.env on each machine, edit, then: set -a; source node.local.env; set +a
# Worker is RANK=1. Start it before rank 0. Addresses and device names below are examples.
RANK=0
HEAD_ADDR=10.10.10.1
FABRIC_IFACE=enp1s0f1np1
ROCE_HCAS=rocep1s0f1,roceP2p1s0f1
GID_INDEX=3
MODEL_SOURCE=/srv/models/GLM-5.3-Flash-FP4-Local
DRAFTER_SOURCE=/srv/models/GLM-5.3-Flash-DFlash2
CACHE_DIR=/srv/cache/glm53-fp4-local-tensorfold
IMAGE=local/glm53-fp4-local-tensorfold:20261017
MASTER_PORT=29592
API_PORT=8888
CONTAINER_NAME=glm53-fp4-local-tensorfold

# Measured tuned profile. Use the same performance settings on both ranks.
TENSORFOLD_MEMORY_RESERVE_GIB=14.5
TF_GLM_CACHE_GIB=8
TF_GLM_MULTI_LONE=0
TF_GLM_MULTI_SAMPLER=packed
TF_GLM_MULTI_ASYNC=1
TF_GLM_DFLASH_POLICY=fnc7:0.3

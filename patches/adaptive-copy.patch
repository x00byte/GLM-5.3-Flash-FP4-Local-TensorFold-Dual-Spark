+"""Proposal-only longest-match lookup with verified, repeated span edits."""
+from __future__ import annotations
+
+import numpy as np
+
+from .copy_drafts import CopyDrafts
+
+
+class AdaptiveCopyDrafts(CopyDrafts):
+    """Learn a repeated rewrite between independently anchored prompt spans.
+
+    Two distinct prompt positions must agree before an edit enters the private
+    proposal index. Insertions/deletions are allowed. The original model still
+    verifies every proposed token; neither its prompt nor weights change.
+    """
+
+    def __init__(self, *args, **kwargs):
+        super().__init__(*args, **kwargs)
+        self.original = self.buf[:self.prompt].copy()
+        self.reply = self.buf[self.prompt:self.length].tolist()
+        self.edits, self.evidence = {}, {}
+        self.blocked = set()
+        self.last, self.source, self.gap = [], None, None
+        self.matched = self.failures = 0
+        self.disabled = False
+
+    def extend(self, tokens):
+        count = len(tokens)
+        missed = 0 < count <= len(self.last) and self.last[count - 1] != int(tokens[-1])
+        if missed and self.edits:
+            self.failures += 1
+            if self.failures >= 3:
+                self.disabled = True
+        elif (missed and self.source is not None and self.gap is None and
+              self.matched >= self.match and count >= 2):
+            position = self.source + count - 1
+            if position < self.prompt:
+                self.gap = position, len(self.reply) + count - 1
+        self.reply.extend(int(t) for t in tokens)
+        super().extend(tokens)
+        self.last, self.source = [], None
+
+    def discard(self):
+        """A prelaunched proposal was bypassed by a short or neural round."""
+        self.proposed = 0
+        self.last, self.source = [], None
+
+    def _observe_span(self, start, stop, replacement):
+        before = self.original[start:stop].tolist()
+        after = list(replacement)
+        while before and after and before[0] == after[0]:
+            before.pop(0); after.pop(0); start += 1
+        while before and after and before[-1] == after[-1]:
+            before.pop(); after.pop()
+        if not before or len(before) > 64 or len(after) > 64:
+            return False
+        old, new = tuple(before), tuple(after)
+        if old in self.blocked:
+            return False
+        evidence = self.evidence.setdefault(old, {})
+        evidence.setdefault(new, set()).add(start)
+        if len(evidence) > 1:
+            self.blocked.add(old)
+            if old in self.edits:
+                self.edits.pop(old)
+                self._rebuild()
+            return False
+        if len(evidence[new]) < 2:
+            return False
+        self.edits[old] = new
+        self._rebuild()
+        return True
+
+    def _rebuild(self):
+        original = self.original.tolist()
+        virtual, at = [], 0
+        while at < len(original):
+            found = False
+            for old, new in self.edits.items():
+                if tuple(original[at:at + len(old)]) == old:
+                    virtual.extend(new); at += len(old); found = True; break
+            if not found:
+                virtual.append(original[at]); at += 1
+        values = virtual + self.reply
+        self.prompt, self.length = len(virtual), len(values)
+        self.buf = np.empty(max(1024, 2 * self.length), dtype=np.int32)
+        self.buf[:self.length] = values
+
+    def propose(self, room=None):
+        self.proposed = 0
+        self.last, self.source = [], None
+        most = self.most if room is None else min(self.most, int(room))
+        if most < 4 or self.disabled:
+            return []
+        hits = self.starts()
+        if not hits.size or hits.size > 256:
+            return []
+        length, match = self.length, self.match
+        matched = match
+        for extra in range(1, min(64 - match, length - match) + 1):
+            eligible = hits[hits >= extra]
+            good = eligible[self.buf[eligible - extra] == self.buf[length - match - extra]]
+            if not good.size:
+                break
+            hits = good
+            matched = match + extra
+        # A new unique anchor closes a preceding mismatch span. Learning stops
+        # after one rule; three further misses fall back to the neural drafter.
+        if len(hits) == 1 and self.gap is not None and not self.edits:
+            source_end = int(hits[0]) + match
+            source_start, reply_start = source_end - matched, len(self.reply) - matched
+            old_start, new_start = self.gap
+            if old_start <= source_start < self.prompt and new_start <= reply_start:
+                self.gap = None
+                if source_start - old_start <= 96 and reply_start - new_start <= 96:
+                    if self._observe_span(old_start, source_start, self.reply[new_start:reply_start]):
+                        return self.propose(room)
+            elif len(self.reply) - new_start > 128:
+                self.gap = None
+        full = hits[hits <= length - match - most]
+        if full.size:
+            hits = full
+        else:
+            most = min(most, int((length - match - hits).max()))
+            hits = hits[hits <= length - match - most]
+        starts = hits + match
+        agreed = []
+        for offset in range(most):
+            values = self.buf[starts + offset]
+            if not np.all(values == values[0]):
+                break
+            agreed.append(int(values[0]))
+        if len(agreed) < 4:
+            return []
+        self.last, self.matched = agreed, matched
+        if len(hits) == 1 and int(starts[0]) < self.prompt:
+            self.source = int(starts[0])
+        self.proposed = len(agreed)
+        return self.padded(agreed, room)

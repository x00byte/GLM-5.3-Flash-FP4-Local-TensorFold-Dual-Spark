+
+
+FORK_SPAN = 64                         # the ids past a kept state that tell one line from another there (``forks``)
+
+
+def forks(after, ids) -> bool:
+    """Two lines past a kept state part: ``after`` (the ids that followed it on the first prompt that wrote or resumed
+    it, up to FORK_SPAN) and ``ids`` (another prompt's) differ where both have ids. Nothing on either side: unknown,
+    False. A conversation's next turn goes on as its last prompt did; another conversation forked there."""
+
+    m = min(len(after), len(ids))
+    return m > 0 and tuple(after[:m]) != tuple(ids[:m])
 
 

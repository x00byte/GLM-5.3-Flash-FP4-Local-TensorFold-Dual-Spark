+"""Exact NVIDIA FP4-Local storage reader. Codes and scale bytes are never requantized.
+
+CSF32 layout follows FlashInfer-b12x loader/_csf_blocks.py's public logical
+format. This decoder expands its lossless palette/exception representation.
+"""
+from __future__ import annotations
+import json, math, re
+from dataclasses import dataclass, is_dataclass
+from functools import lru_cache
+from pathlib import Path
+import numpy as np
+import torch
+from . import qmm
+from .split import RankReader, read_header, rule, rank_cut
+from tensorfold.cuda.nvfp4 import linear as nv, experts as ne
+
+SUPPORTED = {"MXFP8", "FP8_PB_WO", "NVFP4", "W4A16_NVFP4"}
+CSF_PARTS = ("bases", "codes", "page_bases", "offsets", "exceptions")
+
+def validate(config):
+    q = config.get("quantization_config", {})
+    if q.get("quant_method") != "modelopt" or q.get("quant_algo") != "MIXED_PRECISION":
+        raise ValueError("FP4-Local loader requires ModelOpt MIXED_PRECISION")
+    layers=q.get("quantized_layers", {})
+    if not layers or {x.get("quant_algo") for x in layers.values()} - SUPPORTED:
+        raise ValueError("unsupported FP4-Local layer quantization")
+    for name, fmt in layers.items():
+        algo=fmt["quant_algo"]
+        if algo == "MXFP8" and fmt.get("weight_block_size", [1,fmt.get("group_size")]) != [1,32]:
+            raise ValueError(f"{name}: unsupported MXFP8 block")
+        if algo == "FP8_PB_WO" and fmt.get("weight_block_size") != [128,128]:
+            raise ValueError(f"{name}: unsupported FP8 block")
+        if algo in ("NVFP4","W4A16_NVFP4") and fmt.get("group_size",16) != 16:
+            raise ValueError(f"{name}: unsupported NVFP4 group")
+        if fmt.get("weight_scale_encoding") not in (None,"csf_32x2_v1"):
+            raise ValueError(f"{name}: unsupported scale encoding")
+
+@lru_cache(maxsize=32)
+def csf_geometry(rows, cols):
+    if rows % 32 or cols % 2: raise ValueError("CSF32 needs complete 32x2 blocks")
+    grid=np.arange(rows//32*(cols//2)).reshape(rows//32,cols//2)
+    chunks=[grid[r:r+4,c:c+2].T.reshape(-1) for r in range(0,grid.shape[0],4)
+            for c in range(0,grid.shape[1],2)]
+    order=np.concatenate(chunks)
+    inverse=np.argsort(order)
+    counts=np.array([len(c) for c in chunks])
+    pages=np.repeat(np.arange(len(chunks))//32,counts)
+    return order,inverse,np.arange(len(order))+pages
+
+def decode_csf(parts, rows, cols):
+    """Return the original row-major E4M3 scale bytes, including every exception."""
+    bases,codes,page_bases,offsets,exceptions=(np.asarray(p) for p in parts)
+    if bases.shape != (rows,) or codes.size*2 != rows*cols:
+        raise ValueError("invalid CSF32 palette/code geometry")
+    order,inverse,index=csf_geometry(rows,cols)
+    fields=np.empty(codes.size*2,dtype=np.uint8)
+    fields[0::2]=codes&15; fields[1::2]=codes>>4
+    logical=fields.reshape(-1,64)[inverse].reshape(rows//32,cols//2,32,2).transpose(0,2,1,3).reshape(rows,cols)
+    result=(bases[:,None]+logical).astype(np.uint8)
+    # A page holds an independent uint16 prefix, with one shared boundary
+    # per page. page_bases is the byte offset into the exception arena.
+    counts=offsets[index+1].astype(np.int64)-offsets[index].astype(np.int64)
+    if (counts < 0).any() or counts.sum() != exceptions.size:
+        raise ValueError("invalid CSF32 exception prefixes")
+    starts=np.r_[0,np.cumsum(counts)]
+    page_indices=np.arange(len(page_bases))*256
+    page_indices=page_indices[page_indices<len(order)]
+    if not np.array_equal(page_bases.astype(np.int64), starts[page_indices]*2):
+        raise ValueError("invalid CSF32 page bases")
+    rb=np.repeat(order,counts); local=exceptions.astype(np.int64)&255
+    if (local>=64).any(): raise ValueError("invalid CSF32 local position")
+    pos=(rb//(cols//2)*32+local//2)*cols+rb%(cols//2)*2+local%2
+    if pos.size and np.unique(pos).size != pos.size: raise ValueError("duplicate CSF32 exceptions")
+    result.reshape(-1)[pos]=(exceptions>>8).astype(np.uint8)
+    return result
+
+@dataclass
+class Mixed:
+    parts: list
+    @property
+    def n(self): return sum(p.n for p in self.parts)
+    @property
+    def k(self): return self.parts[0].k
+    def matmul(self,x,*,out=None,f32=False,part=None,prefill=False):
+        dtype=torch.float32 if f32 else torch.bfloat16
+        result=out if out is not None else torch.empty((x.shape[0],self.n),device=x.device,dtype=dtype)
+        offset=0
+        for p in self.parts:
+            dest=result[:,offset:offset+p.n]
+            if isinstance(p,qmm.B16):
+                value=qmm.matmul(x,p,out=dest if dest.is_contiguous() else None,f32=f32,part=part)
+            else:
+                mode={nv.Fp4Linear:0,nv.Fp8Linear:1,nv.Mx8Linear:2,nv.Fp8BlockLinear:3}[type(p)]
+                w=p.words if mode==0 else p.w8
+                bs=None if mode==1 else p.bs
+                scale=p.scale if mode in (0,1) else 1.0
+                # Prompt tensor cores preserve each decoded weight exactly for
+                # NVFP4/MXFP8. FP8 block scales require the FP32 lane kernel.
+                use_prompt=prefill and mode in (0,1,2) and x.shape[0]>=4 and p.npad%128==0
+                if mode==2: use_prompt=use_prompt and p.fold
+                if use_prompt:
+                    value=dest if dest.is_contiguous() else torch.empty((x.shape[0],p.n),device=x.device,dtype=dtype)
+                    nv._prompt_ext().prompt16(x,w,bs,float(scale),value,mode,p.n,p.npad,nv.PROMPT_TILE,f32)
+                else:
+                    from tensorfold.cuda.kernels import qmm as shared
+                    sk=shared.split_k(p.n,p.k)
+                    value=dest if dest.is_contiguous() else torch.empty((x.shape[0],p.n),device=x.device,dtype=dtype)
+                    scratch=None
+                    if sk>8:
+                        need=sk*x.shape[0]*p.n
+                        scratch=part.reshape(-1)[:need] if part is not None and part.numel()>=need else torch.empty((need,),device=x.device,dtype=torch.float32)
+                    nv._ext().qmmf(x,w,bs,float(scale),value,scratch,mode,p.n,sk,p.npad,shared.bucket(x.shape[0]),f32)
+            if value is not dest: dest.copy_(value)
+            offset+=p.n
+        return result
+
+class Reader(RankReader):
+    def __init__(self,model_dir,rank,world):
+        super().__init__(model_dir,rank,world)
+        raw=json.loads((Path(model_dir)/"config.json").read_text()); validate(raw)
+        self.formats=raw["quantization_config"]["quantized_layers"]
+    def fmt(self,name):
+        return self.formats.get(name) or self.formats.get(re.sub(r"\.experts\.\d+\.[^.]+$", ".experts",name))
+    def _span(self,name):
+        # Read quantized projections whole, then split codes and decoded scale
+        # planes in the same logical TP coordinates. Scalars stay replicated.
+        root=name.split(".weight")[0].removesuffix(".input_scale")
+        if self.fmt(root) is None: return super()._span(name)
+        file=str(self.dir/self.index[name])
+        if file not in self.files: self.files[file]=read_header(file)
+        h,base=self.files[file]; info=h[name]; a,b=info["data_offsets"]
+        return file,base+a,base+b,"rep",list(info["shape"]),info["dtype"],None
+    def cut(self,name,x):
+        kind=rule(name+".weight")
+        if name=="lm_head": a,b=self.layout.cut("vocab",x.shape[0]); return x[a:b].contiguous()
+        if kind=="rep": return x.contiguous()
+        axis=0 if kind=="row" else 1
+        cut=rank_cut(self.layout,name+".weight",list(x.shape),kind)
+        a,b=cut if cut else (self.rank*x.shape[axis]//self.world,(self.rank+1)*x.shape[axis]//self.world)
+        return (x[a:b] if axis==0 else x[:,a:b]).contiguous()
+    def scales4(self,name,rows,cols):
+        fmt=self.fmt(name)
+        if fmt.get("weight_scale_encoding")=="csf_32x2_v1":
+            parts=[self.get(name+".weight_scale.csf32_"+s).numpy() for s in CSF_PARTS]
+            return torch.from_numpy(decode_csf(parts,rows,cols))
+        return self.get(name+".weight_scale").view(torch.uint8)
+    def raw_linear(self,name):
+        fmt=self.fmt(name); w=self.get(name+".weight")
+        if fmt is None: return w,None,None,None
+        algo=fmt["quant_algo"]
+        if algo in ("NVFP4","W4A16_NVFP4"):
+            s=self.scales4(name,w.shape[0],w.shape[1]//8)
+            return self.cut(name,w),self.cut(name,s),float(self.get(name+".weight_scale_2").item()),algo
+        s=self.get(name+".weight_scale")
+        if algo=="FP8_PB_WO": s=nv.Fp8BlockLinear.column_scales(s.reshape((w.shape[0]+127)//128,w.shape[1]//128),*w.shape)
+        return self.cut(name,w),self.cut(name,s),None,algo
+    def linear(self,name,device):
+        w,s,g,algo=self.raw_linear(name)
+        w=w.to(device)
+        if s is not None: s=s.to(device)
+        if algo is None: return Mixed([qmm.make_b16(w)])
+        if algo in ("NVFP4","W4A16_NVFP4"): p=nv.Fp4Linear.from_checkpoint(w,s,g)
+        elif algo=="MXFP8":
+            p=nv.Mx8Linear.from_checkpoint(w,s)
+            p.fold=bool(((s>=3)&(s<=134)).all())
+        else: p=nv.Fp8BlockLinear.from_rows(w,s)
+        return Mixed([p])
+    def stack(self,names,device):
+        # Fuse adjacent projections with identical storage. All original code
+        # and scale bytes survive; only padding and fragment order change.
+        groups=[]
+        for name in names:
+            raw=self.raw_linear(name)
+            if groups and groups[-1][0][3]==raw[3] and raw[3] in (None,"MXFP8","FP8_PB_WO"):
+                groups[-1].append(raw)
+            else: groups.append([raw])
+        parts=[]
+        for group in groups:
+            algo=group[0][3]
+            w=torch.cat([x[0] for x in group]).to(device)
+            if algo is None: parts.append(qmm.make_b16(w)); continue
+            sc=torch.cat([x[1] for x in group]).to(device)
+            if algo=="MXFP8":
+                p=nv.Mx8Linear.from_checkpoint(w,sc)
+                p.fold=bool(((sc>=3)&(sc<=134)).all())
+            elif algo=="FP8_PB_WO": p=nv.Fp8BlockLinear.from_rows(w,sc)
+            else: p=nv.Fp4Linear.from_checkpoint(w,sc,group[0][2])
+            parts.append(p)
+        return Mixed(parts)
+    def dense(self,name,device):
+        w,s,g,algo=self.raw_linear(name)
+        w=w.to(device)
+        if algo is None: return w.to(torch.bfloat16)
+        if algo=="FP8_PB_WO": out=w.float()*s.to(device).repeat_interleave(64,dim=1)
+        elif algo=="MXFP8": out=w.float()*torch.ldexp(torch.ones_like(s,dtype=torch.float32,device=device),s.to(device).int()-127).repeat_interleave(32,dim=1)
+        else: raise ValueError("dense conversion only for the MLA FP8 absorb matrices")
+        return out.to(torch.bfloat16)
+    def experts(self,p,cfg,device):
+        e,n,d=cfg.experts,self.layout.moe,cfg.hidden
+        up=torch.empty((e,n//32,d//32,2,144),device=device,dtype=torch.int32)
+        down=torch.empty((e,d//32,n//32,1,144),device=device,dtype=torch.int32)
+        us=torch.empty((e,2),device=device,dtype=torch.float32)
+        ds=torch.empty((e,1),device=device,dtype=torch.float32)
+        # Four experts at a time bound both host read staging and GPU packing
+        # temporaries; the full layer never exists twice in GPU memory.
+        for e0 in range(0,e,4):
+            for j,proj in enumerate(("gate_proj","up_proj","down_proj")):
+                names=[p+f"experts.{x}.{proj}" for x in range(e0,min(e,e0+4))]
+                tensors=[z+s for z in names for s in ([".weight", ".weight_scale_2"] + ([".weight_scale.csf32_"+x for x in CSF_PARTS] if self.fmt(z).get("weight_scale_encoding") else [".weight_scale"]))]
+                self.prefetch(tensors)
+                raw=[self.raw_linear(z) for z in names]
+                words=torch.stack([x[0] for x in raw]).to(device)
+                scales=torch.stack([x[1] for x in raw]).to(device)
+                packed=ne.pack(words,scales,chunk=4)
+                if j<2:
+                    up[e0:e0+len(names),:,:,j]=packed
+                    us[e0:e0+len(names),j]=torch.tensor([x[2] for x in raw],device=device)
+                else:
+                    down[e0:e0+len(names),:,:,0]=packed
+                    ds[e0:e0+len(names),0]=torch.tensor([x[2] for x in raw],device=device)
+                del words,scales,packed,raw
+            # Synchronizing bounds host pinned staging on unified-memory GPUs.
+            torch.cuda.current_stream().synchronize()
+        return ne.Experts4(up,down,us,ds,n,d,cfg.limit)
+
+def estimate(lay):
+    def transform(name,info):
+        if name.startswith("model.visual."): return 0,0
+        if ".input_scale" in name or ".weight_scale" in name: return 0,0
+        shape=list(info["shape"]); dtype=info["dtype"]
+        if ".mlp.experts." in name and name.endswith(".weight"):
+            # packed codes plus all expanded scale bytes, 576 bytes per 32x32
+            return math.prod(shape)*9//8//lay.world+4,0
+        kind=rule(name)
+        if name=="lm_head.weight": shape[0]=lay.vocab
+        elif kind!="rep":
+            axis=0 if kind=="row" else 1
+            a,b=rank_cut(lay,name,shape,kind) or (0,shape[axis]//lay.world)
+            shape[axis]=b-a
+        count=math.prod(shape)
+        if dtype=="F8_E4M3":
+            if "kv_b_proj" in name: return count*2,0
+            return math.ceil(shape[0]/128)*128*shape[1]*17//16 + (count*9//16 if name=="lm_head.weight" else 0),0
+        if dtype=="U8": return count*9//8,0
+        size={"BF16":2,"F16":2,"F32":4,"U8":1,"U32":4,"U16":2}.get(dtype)
+        if size is None: raise ValueError(f"unknown weight dtype {dtype}")
+        return count*size,0
+    return transform
